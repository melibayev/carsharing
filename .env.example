# Postgres
POSTGRES_DB=CarSharing
POSTGRES_USER=CarSharing
POSTGRES_PASSWORD=change_me

# JWT
JWT_SECRET=replace-with-32-character-or-longer-secret
JWT_ISSUER=CarSharing
JWT_AUDIENCE=CarSharing-web
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Cloudinary (optional in dev — falls back to local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=hello@carsharing.dev

# App
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true
AUTO_APPROVE_CARS_IN_DEV=true
CORS_ORIGINS=http://localhost:3000

# Twilio SMS (optional — set TWILIO_ENABLED=false in dev to write to /app/dev-sms.log)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
